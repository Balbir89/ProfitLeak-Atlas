table Monthly

	measure 'Total Spend' = SUM(Monthly[spend_eur])
		formatString: €#,##0

	measure 'Total Exposure' = SUM(Monthly[gross_loss_eur])
		formatString: €#,##0

	measure 'Potential Recovery' = SUM(Monthly[modeled_recovery_eur])
		formatString: €#,##0

	measure 'Screened Payments' = SUM(Monthly[payments])
		formatString: #,##0

	measure 'Flagged Payments' = SUM(Monthly[flagged_payments])
		formatString: #,##0

	column payment_month
		dataType: string
		sourceColumn: payment_month
		summarizeBy: none

	column payments
		dataType: int64
		sourceColumn: payments
		summarizeBy: none

	column spend_eur
		dataType: double
		sourceColumn: spend_eur
		summarizeBy: none

	column flagged_payments
		dataType: int64
		sourceColumn: flagged_payments
		summarizeBy: none

	column gross_loss_eur
		dataType: double
		sourceColumn: gross_loss_eur
		summarizeBy: none

	column modeled_recovery_eur
		dataType: double
		sourceColumn: modeled_recovery_eur
		summarizeBy: none

	partition Monthly = m
		mode: import
		source =
			#table(type table [payment_month = text, payments = Int64.Type, spend_eur = number, flagged_payments = Int64.Type, gross_loss_eur = number, modeled_recovery_eur = number], {
